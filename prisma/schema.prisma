generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JOB_SEEKER
  COMPANY
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         Role
  fullName     String?
  companyName  String?
  createdAt    DateTime @default(now())

  jobs         Job[]            @relation("CompanyJobs")
  applications Application[]    @relation("JobSeekerApplications")
}

model Job {
  id           String   @id @default(uuid())
  title        String
  description  String
  location     String
  salaryMin    Int?
  salaryMax    Int?
  jobType      JobType
  companyId    String
  company      User     @relation("CompanyJobs", fields: [companyId], references: [id])
  createdAt    DateTime @default(now())

  applications Application[]
}

model Application {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id])
  jobSeekerId  String
  jobSeeker    User     @relation("JobSeekerApplications", fields: [jobSeekerId], references: [id])
  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history      ApplicationHistory[]

  @@unique([jobId, jobSeekerId])
}

model ApplicationHistory {
  id             String   @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  status         ApplicationStatus
  changedAt      DateTime @default(now())
  changedBy      String
}
